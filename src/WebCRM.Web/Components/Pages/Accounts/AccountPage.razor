@page "/accounts/new"
@page "/accounts/{Id:int}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using WebCRM.Core
@using WebCRM.Core.Accounts
@using WebCRM.Core.Lookups
@using WebCRM.Core.Records
@using WebCRM.Core.Personal
@using WebCRM.Core.Search
@using WebCRM.Core.Users
@using WebCRM.Web.Components.Shared
@inject IAccountService Accounts
@inject IUserContextProvider UserContexts
@inject IRecentViewService RecentViews
@inject ILogger<AccountPage> Logger
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>@PageTitleText</PageTitle>

@if (_loading)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="220px" />
}
else
{
    <MudBreadcrumbs Items="_crumbs" Class="px-0" />

    <RecordHeader Title="@PageTitleText" EditContext="_editor.Context" IsEditing="_editor.IsEditing" Saving="_editor.IsSaving"
                  OnEdit="BeginEdit" OnSave="SaveAsync" OnCancel="CancelAsync">
        <StatusChip>
            @if (_detail is not null)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@_detail.StatusName</MudChip>
            }
        </StatusChip>

        <Alerts>
            <ConcurrencyAlert Conflict="_editor.Conflict" CanOverwrite="_user?.IsAdmin == true"
                              OnReload="ReloadAsync" OnOverwrite="OverwriteAsync" />
            <SaveWarningAlert Warning="_editor.Warning" OnAccept="SaveAnywayAsync" OnDismiss="_editor.DismissWarning" />
        </Alerts>

        <Actions>
            @if (_detail is not null)
            {
                <StarButton Type="SearchEntity.Account" RecordId="_detail.Id" />
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AttachMoney" Href="@($"opportunities/new?accountId={_detail.Id}")">
                    New opportunity
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteAsync">
                    Delete
                </MudButton>
            }
        </Actions>

        <ReadContent>
            @if (_detail is not null)
            {
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6" md="4"><ReadField Label="Legal name" Value="@_detail.LegalName" /></MudItem>
                    <MudItem xs="12" sm="6" md="4"><ReadField Label="VAT / Tax ID" Value="@_detail.VatNumber" /></MudItem>
                    <MudItem xs="12" sm="6" md="4"><ReadField Label="Tax office (ΔΟΥ)" Value="@_detail.TaxOffice" /></MudItem>
                    <MudItem xs="12" sm="6" md="4"><ReadField Label="Industry" Value="@_detail.IndustryName" /></MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <ReadField Label="Phone">
                            @if (!string.IsNullOrWhiteSpace(_detail.Phone))
                            {
                                <MudLink Href="@Links.TelUri(_detail.Phone)">@_detail.Phone</MudLink>
                            }
                        </ReadField>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <ReadField Label="Email">
                            @if (Links.MailtoUri(_detail.Email) is { } mail)
                            {
                                <MudLink Href="@mail">@_detail.Email</MudLink>
                            }
                        </ReadField>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <ReadField Label="Website">
                            @if (!string.IsNullOrWhiteSpace(_detail.Website))
                            {
                                <MudLink Href="@_detail.Website" Target="_blank" rel="noopener noreferrer">@_detail.Website</MudLink>
                            }
                        </ReadField>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <ReadField Label="Owner">
                            <OwnerBadge Name="@_detail.OwnerName" IsActive="_detail.OwnerIsActive" />
                        </ReadField>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <ReadField Label="Created" Value="@TimeDisplay.Format(_detail.CreatedAt)" />
                    </MudItem>
                </MudGrid>
            }
        </ReadContent>

        <EditContent>
            @if (_editor.Model is { } model)
            {
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="8">
                        <MudTextField @bind-Value="model.Name" For="@(() => model.Name)" Label="Name" Required="true"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" AutoFocus="true" MaxLength="200" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="model.VatNumber" For="@(() => model.VatNumber)" Label="VAT / Tax ID"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="30" />
                    </MudItem>
                    <MudItem xs="12" md="8">
                        <MudTextField @bind-Value="model.LegalName" For="@(() => model.LegalName)" Label="Legal name"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="200"
                                      HelperText="Only if it differs from the name above" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="model.TaxOffice" For="@(() => model.TaxOffice)" Label="Tax office (ΔΟΥ)"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="100" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <LookupSelect Kind="LookupKind.Industry" Label="Industry"
                                      @bind-Value="model.IndustryId" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <LookupSelect Kind="LookupKind.AccountStatus" Label="Status" Required="true"
                                      @bind-Value="model.AccountStatusId" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <OwnerPicker Required="true" @bind-Value="model.OwnerId" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField @bind-Value="model.Phone" For="@(() => model.Phone)" Label="Phone" InputType="InputType.Telephone"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="30" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField @bind-Value="model.Email" For="@(() => model.Email)" Label="Email" InputType="InputType.Email"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="254" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField @bind-Value="model.Website" For="@(() => model.Website)" Label="Website" InputType="InputType.Url"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="300"
                                      HelperText="https://example.com" />
                    </MudItem>
                </MudGrid>
            }
        </EditContent>
    </RecordHeader>

    @* Related records load when their tab is first opened. A new account has none yet: the tabs appear after the first save. *@
    @if (_detail is not null)
    {
        <RecordTabs @key="_detail.Id" Tabs="_tabs" />
    }
}

@code {
    private const int NotLoaded = -1;

    private readonly RecordEditor<AccountEditModel> _editor = new();
    private int _loadedFor = NotLoaded;
    private UserContext? _user;
    private AccountDetail? _detail;
    private bool _loading = true;
    private List<BreadcrumbItem> _crumbs = [];
    private IReadOnlyList<RecordTabItem> _tabs = [];

    /// <summary>Null on /accounts/new.</summary>
    [Parameter] public int? Id { get; set; }

    private bool IsNew => Id is null;

    private string PageTitleText => IsNew ? "New account" : _detail?.Name ?? "Account";

    protected override async Task OnParametersSetAsync()
    {
        var key = Id ?? 0;
        if (key == _loadedFor)
        {
            return;
        }

        _loading = true;
        _user ??= await UserContexts.GetAsync();
        if (_user is null)
        {
            return;
        }

        _detail = null;
        _editor.End();

        if (IsNew)
        {
            _editor.Begin(await Accounts.NewAsync(_user));
        }
        else
        {
            _detail = await Accounts.GetAsync(Id!.Value, _user);
            if (_detail is null)
            {
                // Missing, deleted and not visible all look the same, so ids can't be probed.
                Navigation.NotFound();
                return;
            }

            await RememberVisitAsync();
        }

        _tabs = IsNew ? [] : BuildTabs(Id!.Value);

        _crumbs =
        [
            new BreadcrumbItem("Accounts", "accounts"),
            new BreadcrumbItem(PageTitleText, href: null, disabled: true),
        ];
        _loadedFor = key;
        _loading = false;
    }

    // Feeds the "Recently viewed" lists. A failure here must never stop the page from showing.
    private async Task RememberVisitAsync()
    {
        try
        {
            await RecentViews.RecordAsync(_user!, SearchEntity.Account, Id!.Value);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Could not record the view of account {Id}", Id);
        }
    }

    private static IReadOnlyList<RecordTabItem> BuildTabs(int accountId)
    {
        RenderFragment overview = @<AccountOverviewTab AccountId="accountId" />;
        RenderFragment contacts = @<AccountContactsTab AccountId="accountId" />;
        RenderFragment opportunities = @<AccountOpportunitiesTab AccountId="accountId" />;
        return
        [
            new RecordTabItem("Overview", overview),
            new RecordTabItem("Contacts", contacts),
            new RecordTabItem("Opportunities", opportunities),
        ];
    }

    // ---- Edit mode ----

    private void BeginEdit() => _editor.Begin(_detail!.ToEditModel());

    private Task CancelAsync()
    {
        if (IsNew)
        {
            Navigation.NavigateTo("accounts");
            return Task.CompletedTask;
        }

        _editor.End();
        return Task.CompletedTask;
    }

    private async Task ReloadAsync()
    {
        _detail = await Accounts.GetAsync(Id!.Value, _user!);
        if (_detail is null)
        {
            Navigation.NotFound();
            return;
        }

        _editor.End();
    }

    // ---- Save ----

    private Task SaveAsync() => SaveAsync(new SaveOptions());

    private Task SaveAnywayAsync() => SaveAsync(new SaveOptions { AcceptWarnings = true });

    private Task OverwriteAsync() => SaveAsync(new SaveOptions { AcceptWarnings = true, Overwrite = true });

    private Task SaveAsync(SaveOptions options) => _editor.SaveAsync(
        save: o => Accounts.SaveAsync(_editor.Model!, _user!, o),
        options: options,
        onSaved: AfterSavedAsync,
        onNotFound: () =>
        {
            Snackbar.Add("This account no longer exists.", Severity.Warning);
            Navigation.NavigateTo("accounts");
            return Task.CompletedTask;
        },
        onError: _ => Snackbar.Add("Could not save the account. Please try again.", Severity.Error));

    private async Task AfterSavedAsync(SaveResult result)
    {
        Snackbar.Add("Account saved.", Severity.Success);

        // Mark clean first so the unsaved-changes guard does not fire on our own navigation.
        _editor.MarkClean();

        if (IsNew)
        {
            Navigation.NavigateTo($"accounts/{result.Id}", new NavigationOptions { ReplaceHistoryEntry = true });
            return;
        }

        _detail = await Accounts.GetAsync(result.Id, _user!);
        _editor.End();
    }

    // ---- Delete ----

    private async Task DeleteAsync()
    {
        var impact = await Accounts.GetDeleteImpactAsync(Id!.Value, _user!);
        if (impact is null)
        {
            Navigation.NotFound();
            return;
        }

        if (impact.OpenOpportunities > 0)
        {
            Snackbar.Add(
                $"This account has {impact.OpenOpportunities} open {(impact.OpenOpportunities == 1 ? "opportunity" : "opportunities")}. Close or reassign {(impact.OpenOpportunities == 1 ? "it" : "them")} first.",
                Severity.Warning);
            return;
        }

        var affected = impact.Contacts == 0
            ? "It has no contacts."
            : $"Its {impact.Contacts} {(impact.Contacts == 1 ? "contact" : "contacts")} will be deleted with it.";

        if (!await Dialogs.ConfirmAsync("Delete account?", $"Delete {_detail!.Name}? {affected}", "Delete"))
        {
            return;
        }

        var result = await Accounts.DeleteAsync(Id!.Value, _user!);
        if (result.Status == AccountDeleteStatus.Blocked)
        {
            Snackbar.Add(result.Message ?? "This account cannot be deleted.", Severity.Warning);
            return;
        }

        Snackbar.Add("Account deleted.", Severity.Success);
        Navigation.NavigateTo("accounts");
    }
}
