@page "/search"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Logging
@using WebCRM.Core.Search
@using WebCRM.Core.Users
@using WebCRM.Web.Components.Shared
@inject ISearchService Search
@inject IUserContextProvider UserContexts
@inject NavigationManager Navigation
@inject ILogger<SearchPage> Logger

<PageTitle>@(string.IsNullOrWhiteSpace(Q) ? "Search" : $"Search: {Q}")</PageTitle>

@* P7: results grouped by type, up to 20 per group, with "See all in list" opening that list with the quick filter set. *@

<MudStack Spacing="3">
    <MudText Typo="Typo.h4" HtmlTag="h1">Search</MudText>

    <MudTextField T="string" @bind-Value="_input" Immediate="true" Placeholder="Search accounts, contacts, opportunities and leads" aria-label="Search"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" OnKeyDown="OnKeyDown"
                  Style="max-width: 520px;" />

    @if (SearchRules.Normalize(Q) is null)
    {
        <MudText Color="Color.Secondary" role="status">Type at least @SearchRules.MinLength characters to search.</MudText>
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
            @_error
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="LoadAsync" Class="ml-2">Retry</MudButton>
        </MudAlert>
    }
    else if (_loading)
    {
        <MudStack Spacing="1" aria-busy="true">
            @for (var i = 0; i < 4; i++)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="44px" />
            }
        </MudStack>
    }
    else if (_results is { } results)
    {
        @if (results.TotalCount == 0)
        {
            <MudPaper Outlined="true" Class="pa-8 d-flex flex-column align-center" role="status">
                <MudText Typo="Typo.h6">No results</MudText>
                <MudText Color="Color.Secondary">Nothing matches &ldquo;@results.Query&rdquo;. Check the spelling, or try part of a name, an email or a VAT / Tax ID.</MudText>
            </MudPaper>
        }
        else
        {
            @foreach (var group in results.Groups)
            {
                <section aria-label="@SearchLinks.Label(group.Type)" data-search-group="@group.Type">
                    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-1">
                        @SearchLinks.Label(group.Type) <MudText Typo="Typo.body2" Color="Color.Secondary" Inline="true">(@group.TotalCount)</MudText>
                    </MudText>

                    @if (group.Hits.Count == 0)
                    {
                        <MudText Color="Color.Secondary">No @SearchLinks.Label(group.Type).ToLowerInvariant() match.</MudText>
                    }
                    else
                    {
                        <MudPaper Outlined="true">
                            @foreach (var hit in group.Hits)
                            {
                                <a href="@SearchLinks.Record(hit)" class="mud-list-item mud-list-item-clickable px-4 py-2 d-flex align-center"
                                   style="text-decoration: none; color: inherit;" data-search-hit="@SearchLinks.Record(hit)">
                                    <MudIcon Icon="@SearchLinks.Icon(hit.Type)" Size="Size.Small" Class="mr-3" />
                                    <div>
                                        <MudText Typo="Typo.body1">@hit.Title</MudText>
                                        @if (hit.Subtitle is not null)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@hit.Subtitle</MudText>
                                        }
                                    </div>
                                </a>
                            }
                        </MudPaper>

                        @if (group.TotalCount > group.Hits.Count)
                        {
                            <MudLink Href="@SearchLinks.List(group.Type, results.Query)" Class="mt-1 d-inline-block" data-search-see-all="@group.Type">
                                See all @group.TotalCount @SearchLinks.Label(group.Type).ToLowerInvariant() in the list
                            </MudLink>
                        }
                    }
                </section>
            }
        }
    }
</MudStack>

@code {
    private const int PerGroup = 20;

    private CancellationTokenSource? _cts;
    private SearchResults? _results;
    private string? _loadedFor;
    private string _input = string.Empty;
    private string? _error;
    private bool _loading;

    /// <summary>The text from the top bar or a shared link: /search?q=</summary>
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == Q)
        {
            return;
        }

        _loadedFor = Q;
        _input = Q ?? string.Empty;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _cts?.Cancel();
        _error = null;
        _results = null;

        if (SearchRules.Normalize(Q) is not { } term)
        {
            _loading = false;
            return;
        }

        var cts = _cts = new CancellationTokenSource();
        _loading = true;
        try
        {
            var user = await UserContexts.GetAsync(cts.Token);
            _results = user is null ? SearchResults.Empty(term) : await Search.SearchAsync(term, PerGroup, user, cts.Token);
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Search failed.");
            if (!cts.IsCancellationRequested)
            {
                _error = "Search failed.";
            }
        }
        finally
        {
            // Whatever happened, the skeleton must go: show the results, or the error with Retry. This runs after an
            // await, outside any event handler, so Blazor does not re-render by itself.
            if (!cts.IsCancellationRequested)
            {
                _loading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && SearchRules.Normalize(_input) is { } term)
        {
            Navigation.NavigateTo(SearchLinks.ResultsPage(term));
        }
    }
}
