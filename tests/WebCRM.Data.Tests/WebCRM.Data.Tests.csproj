<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 test projects are self-hosting executables, run by Microsoft.Testing.Platform
         (opted in for dotnet test via global.json). -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- Tests tagged [Trait("Category", "Performance")] assert on elapsed time, so they depend on the machine and
       its load. They are left out of the normal run (local and CI) and run on demand:
         dotnet test (project tests/WebCRM.Data.Tests) with the property RunPerformance=true
       (docs/testing.md) -->
  <PropertyGroup Condition="'$(RunPerformance)' == 'true'">
    <TestingPlatformCommandLineArguments>--filter-trait "Category=Performance"</TestingPlatformCommandLineArguments>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RunPerformance)' != 'true'">
    <TestingPlatformCommandLineArguments>--filter-not-trait "Category=Performance"</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WebCRM.Core\WebCRM.Core.csproj" />
    <ProjectReference Include="..\..\src\WebCRM.Data\WebCRM.Data.csproj" />
    <ProjectReference Include="..\..\src\WebCRM.DemoData\WebCRM.DemoData.csproj" />
  </ItemGroup>

</Project>
